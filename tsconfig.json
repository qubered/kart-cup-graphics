{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "noEmit": true, "verbatimModuleSyntax": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["node", "svelte"]
  },
  "include": ["shared", "server", "scripts", "web/src", "tests"]
}
